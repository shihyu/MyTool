#!/usr/bin/env python3

import sys
import re
import os


def insert_debug_log(file_path):
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        print(f"Error reading {file_path}: {e}")
        return False

    lines = content.split("\n")
    modified = False

    # Check if trace macro already exists
    has_trace_macro = any("macro_rules! trace" in line for line in lines)

    # Find where to insert the macro (after initial comments and before first use/mod/etc)
    insert_index = 0
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped and not stripped.startswith("//") and not stripped.startswith("#["):
            insert_index = i
            break

    # Insert trace macro if it doesn't exist
    if not has_trace_macro:
        macro_lines = [
            "// 自動生成的追蹤宏",
            "macro_rules! trace {",
            "    (:expr) => {",
            "    };",
            "}",
            "",
        ]
        for j, macro_line in enumerate(macro_lines):
            lines.insert(insert_index + j, macro_line)
        modified = True

    # Find functions and add trace calls
    new_lines = []
    i = 0
    while i < len(lines):
        line = lines[i]
        new_lines.append(line)

        # Look for function definitions
        if re.match(r"\s*(pub\s+)?(async\s+)?fn\s+\w+", line.strip()):
            # Find the opening brace
            brace_line = i
            while brace_line < len(lines) and "{" not in lines[brace_line]:
                brace_line += 1
                if brace_line < len(lines):
                    new_lines.append(lines[brace_line])

            if brace_line < len(lines):
                # Get the indentation of the function
                func_indent = len(line) - len(line.lstrip())
                trace_indent = " " * (func_indent + 2)

                # Extract function name for trace
                func_match = re.search(r"fn\s+(\w+)", line)
                func_name = func_match.group(1) if func_match else "function"

                # Check if trace already exists in the function
                has_trace = False
                j = brace_line + 1
                while j < len(lines) and not (
                    lines[j].strip()
                    and not lines[j].startswith(" ")
                    and not lines[j].startswith("\t")
                ):
                    if f'trace!("{func_name}")' in lines[j]:
                        has_trace = True
                        break
                    if lines[j].strip() == "}":
                        break
                    j += 1

                # Add trace call if it doesn't exist
                if not has_trace:
                    new_lines.append(f'{trace_indent}trace!("{func_name}");')
                    modified = True

                i = brace_line

        i += 1

    # Write back if modified
    if modified:
        try:
            with open(file_path, "w", encoding="utf-8") as f:
                f.write("\n".join(new_lines))
            print(f"Modified: {file_path}")
            return True
        except Exception as e:
            print(f"Error writing {file_path}: {e}")
            return False
    else:
        print(f"No changes needed: {file_path}")
        return True


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: insert_debug_log <rust_file>")
        sys.exit(1)

    file_path = sys.argv[1]
    if not file_path.endswith(".rs"):
        print("Error: Only .rs files are supported")
        sys.exit(1)

    if not os.path.exists(file_path):
        print(f"Error: File {file_path} does not exist")
        sys.exit(1)

    success = insert_debug_log(file_path)
    sys.exit(0 if success else 1)
