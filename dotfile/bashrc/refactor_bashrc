# 簡繁體轉換
function s2t_convert() {
    mkdir -p output
    for file in *; do
        if [ -f "$file" ]; then
            new_file=$(echo "$file" | opencc -c s2tw.json)
            mv "$file" "output/$new_file"
        fi
    done
}

function myopencc() {
    if [ "$1" == '' ]; then
        FILES=$(find . -name "*.md")
    else
        FILES=$(find . -name "*.$1")
    fi
    IFS=$'\n'
    for doc in $FILES; do
        doc=${doc#./}
        doc1="$doc""~"
        echo "$doc"
        echo "$doc1"
        opencc -i "$doc" -o "$doc1" -c s2tw.json
        mv "$doc1" "$doc"
    done
    unset IFS
}

