# GitHub clone all repos
function cloneall() {
    curl -s https://api.github.com/users/$1/repos?per_page=200 | python -c $'import json, sys, os\nfor repo in json.load(sys.stdin): os.system("git clone " + repo["git_url"])'
}

clone_all_repos() {
    if [ -z "$1" ]; then
        echo "Usage: clone_all_repos <username> [github_token]"
        return 1
    fi
    
    local username=$1
    local token=$2
    local api_header=""
    
    # 如果提供了 token 就使用
    if [ -n "$token" ]; then
        api_header="-H Authorization: token $token"
    fi
    
    # 創建目錄
    mkdir -p "${username}-repos"
    cd "${username}-repos"
    
    echo "正在獲取 $username 的所有 repositories..."
    
    # 使用 jq 處理 JSON（如果有安裝）
    if command -v jq &> /dev/null; then
        curl $api_header -s "https://api.github.com/users/$username/repos?per_page=100" | \
            jq -r '.[].clone_url' | \
            xargs -n 1 git clone
    else
        # 沒有 jq 的備用方案
        curl $api_header -s "https://api.github.com/users/$username/repos?per_page=100" | \
            grep '"clone_url"' | \
            awk '{print $2}' | \
            sed 's/[",]//g' | \
            xargs -n 1 git clone
    fi
    
    echo "下載完成！"
}

